import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS series (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  description TEXT,
  addedAt INTEGER NOT NULL,
  updatedAt INTEGER NOT NULL,

  inProgress INTEGER AS Boolean NOT NULL DEFAULT 0,
  hasActiveBook INTEGER AS Boolean NOT NULL DEFAULT 0,
  hideFromContinueListening INTEGER AS Boolean NOT NULL DEFAULT 0,
  bookInProgressLastUpdate INTEGER,
  firstBookUnreadId TEXT,

  libraryId TEXT NOT NULL,
  userId TEXT NOT NULL,

  FOREIGN KEY (userId) REFERENCES user(id) ON DELETE CASCADE
);

insertOrIgnore:
INSERT OR IGNORE INTO series
VALUES ?;

update:
UPDATE series
SET name = :name,
    description = :description,
    addedAt = :addedAt,
    updatedAt = :updatedAt,
    inProgress = :inProgress,
    hasActiveBook = :hasActiveBook,
    hideFromContinueListening = :hideFromContinueListening,
    bookInProgressLastUpdate = :bookInProgressLastUpdate,
    firstBookUnreadId = :firstBookUnreadId
WHERE libraryId = :libraryId
  AND id = :id;

existsById:
SELECT 1 FROM series
WHERE id = ?
  AND libraryId = ?
LIMIT 1;

selectAll:
SELECT * FROM series;

selectById:
SELECT * FROM series
WHERE id = ?;

selectByLibraryId:
SELECT * FROM series
WHERE libraryId = ?
ORDER BY name ASC;

selectByShelfId:
SELECT * FROM series
INNER JOIN shelfJoin ON shelfJoin.entityId = series.id
WHERE shelfJoin.shelfId = ?
ORDER BY shelfJoin.shelfOrder ASC;

deleteForLibraryId:
DELETE FROM series
WHERE libraryId = ?;

deleteById:
DELETE FROM series
WHERE id = ?
  AND libraryId = ?;

selectContinueSeries:
SELECT series.* FROM series
WHERE series.libraryId = :libraryId
  AND NOT EXISTS (
    SELECT 1 FROM seriesBookJoin sbj_active
    JOIN mediaProgress mp_active ON mp_active.libraryItemId = sbj_active.libraryItemId AND mp_active.userId = :userId
    WHERE sbj_active.seriesId = series.id AND mp_active.isFinished = 0 AND (mp_active.progress > 0 OR mp_active.currentTime > 0)
  )
  AND NOT EXISTS (
    SELECT 1 FROM media m_active
    JOIN mediaProgress mp_m_active ON mp_m_active.libraryItemId = m_active.libraryItemId AND mp_m_active.userId = :userId
    WHERE m_active.metadata_series_id = series.id AND mp_m_active.isFinished = 0 AND (mp_m_active.progress > 0 OR mp_m_active.currentTime > 0)
  )
  AND (
    EXISTS (
      SELECT 1 FROM shelfJoin sj
      LEFT JOIN seriesBookJoin sbj_sj ON sbj_sj.libraryItemId = sj.entityId
      LEFT JOIN media m_sj ON m_sj.libraryItemId = sj.entityId
      WHERE (sbj_sj.seriesId = series.id OR m_sj.metadata_series_id = series.id)
        AND sj.shelfId LIKE 'continue-series_%'
    )
    OR (
      (
        series.inProgress = 1
        OR EXISTS (
          SELECT 1 FROM seriesBookJoin sbj_start
          JOIN mediaProgress mp_start ON mp_start.libraryItemId = sbj_start.libraryItemId AND mp_start.userId = :userId
          WHERE sbj_start.seriesId = series.id AND (mp_start.progress > 0 OR mp_start.currentTime > 0 OR mp_start.isFinished = 1)
        )
        OR EXISTS (
          SELECT 1 FROM media m_start
          JOIN mediaProgress mp_m_start ON mp_m_start.libraryItemId = m_start.libraryItemId AND mp_m_start.userId = :userId
          WHERE m_start.metadata_series_id = series.id AND (mp_m_start.progress > 0 OR mp_m_start.currentTime > 0 OR mp_m_start.isFinished = 1)
        )
      )
      AND EXISTS (
        SELECT 1 FROM seriesBookJoin sbj_unread
        LEFT JOIN mediaProgress mp_done ON mp_done.libraryItemId = sbj_unread.libraryItemId AND mp_done.userId = :userId AND mp_done.isFinished = 1
        WHERE sbj_unread.seriesId = series.id AND mp_done.libraryItemId IS NULL
      )
    )
  )
GROUP BY series.id
ORDER BY COALESCE(series.bookInProgressLastUpdate, series.updatedAt) DESC;

insertMissingShelfSeries:
INSERT OR IGNORE INTO series (
  id,
  name,
  description,
  addedAt,
  updatedAt,
  inProgress,
  hasActiveBook,
  hideFromContinueListening,
  bookInProgressLastUpdate,
  firstBookUnreadId,
  libraryId,
  userId
)
SELECT 
  media.metadata_series_id,
  COALESCE(media.metadata_series_name, ''),
  NULL,
  libraryItem.addedAt,
  libraryItem.updatedAt,
  1,
  0,
  0,
  libraryItem.updatedAt,
  libraryItem.id,
  libraryItem.libraryId,
  :userId
FROM shelfJoin
JOIN media ON media.libraryItemId = shelfJoin.entityId
JOIN libraryItem ON libraryItem.id = shelfJoin.entityId
WHERE shelfJoin.shelfId LIKE 'continue-series_%'
  AND media.metadata_series_id IS NOT NULL;

