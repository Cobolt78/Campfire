+fun Duration.formatHoursAndMinutes(): String {
+  val hours = inWholeHours
+  val minutes = inWholeMinutes % 60
+  return buildString {
+    if (hours > 0) {
+      append("${hours}h ")
+    }
+    if (minutes > 0 || hours == 0L) {
+      append("${minutes}m")
+    }
+  }.trim()
