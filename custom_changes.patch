+        style = MaterialTheme.typography.bodyMedium,
+      )
+    },
+    confirmButton = {
+      TextButton(onClick = onConfirm) {
+        Text(confirmButtonText)
+      }
+    },
+    dismissButton = {
+      TextButton(onClick = onDismissRequest) {
+        Text(dismissButtonText)
+      }
