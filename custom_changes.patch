+          "titleIgnorePrefix": "Some Show"
+        },
+        "coverPath": "/metadata/items/li_1/cover.jpg",
+        "tags": [],
+        "numEpisodes": 2,
+        "autoDownloadEpisodes": false,
+        "autoDownloadSchedule": "0 * * * *",
+        "lastEpisodeCheck": 1733000000000,
+        "maxEpisodesToKeep": 0,
+        "maxNewEpisodesToDownload": 3,
+        "size": 123456
+      },
+      "numFiles": 3,
